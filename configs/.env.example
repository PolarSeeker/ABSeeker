# Copy to configs/.env and fill in before running.
#   cp configs/.env.example configs/.env

# ── Agent LLM (ABSeeker checkpoint on SGLang/vLLM or remote gateway) ─────────
ABSEEKER_BASE_URL=http://127.0.0.1:30016/v1
ABSEEKER_MODEL=models/ABSeeker-4B

# ── Web search ────────────────────────────────────────────────────────────────
SERPER_API_KEY=

# ── Webpage fetch (Jina Reader) ───────────────────────────────────────────────
JINA_API_KEY=
VISIT_HTTP_PROXY=http://127.0.0.1:6478

# ── Summary / judge LLM (visit_web, eval.py, ABC pipeline) ──────────────────
# VISIT_SERVER: local | oss | ds | gpugeek
VISIT_SERVER=local
SUMMARY_MODEL_NAME=

# When VISIT_SERVER=ds
DEEPSEEK_URL=https://your-llm-gateway.example.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# When VISIT_SERVER=gpugeek
GPUGEEK_URL=https://api.gpugeek.com/v1
GPUGEEK_API_KEY=
GPUGEEK_MODEL=

# When VISIT_SERVER=oss or local
GPT_OSS_URL=http://127.0.0.1:3000/v1
GPT_OSS_API_KEY=
GPT_OSS_MODEL=gpt-oss-20b
