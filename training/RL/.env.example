# Copy to RL/.env and fill in values before running train_abseeker.sh
#   cp .env.example .env

# ── Model (full HF dir: weights + tokenizer_config.json + chat_template) ─────
MODEL_PATH=/path/to/sft-checkpoint

# ── RL dataset (parquet) ─────────────────────────────────────────────────────
# TRAIN_DATA=/path/to/train.parquet
# VAL_DATA=/path/to/val.parquet

# ── Shared tool / visit API (used by dr_agent_loop search & visit) ──────────
API_BASE=
API_KEY=
SUMMARY_MODEL_NAME=

SERPER_KEY_ID=

JINA_API_KEYS=
# Visit (Jina) HTTP proxy; Serper search does not use this
PROXY=http://127.0.0.1:5090

# ── Outcome LLM judge (Phase 1 fallback in abseeker_batch, BrowseComp 0/1) ─
JUDGE_API_BASE=
JUDGE_API_KEY=
JUDGE_MODEL_NAME=
ENABLE_JUDGE_THINKING=false

# ── ABSeeker anchor-clue per-turn judge (online RL scoring) ───────────────
# Called by agent loop after each assistant turn; writes extra_info.abseeker_turn_scores
ABSEEKER_ANCHOR_API_BASE=
ABSEEKER_ANCHOR_API_KEY=
ABSEEKER_ANCHOR_MODEL_NAME=
ABSEEKER_ANCHOR_ENABLE_THINKING=false
ABSEEKER_ANCHOR_TIMEOUT=120
ABSEEKER_ANCHOR_TEMPERATURE=0.0

# ── Distributed networking (optional) ─────────────────────────────────────────
GLOO_SOCKET_IFNAME=
